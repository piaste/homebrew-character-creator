<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- 
      Warnings off:
          - type tests ignore UoMs
          - single tuples in lists 
          - don't warn for automatic implicit conversions 
    -->
    <NoWarn>FS1240;FS3391;FS3386</NoWarn>
    
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Utils.fs" />
    <Compile Include="Domain\Types.fs" />
    <Compile Include="Domain\Entities\BaseRaces.fs" />
    <Compile Include="Domain\Entities\Subraces.fs" />
    <Compile Include="Domain\Entities\Archetypes.fs" />
    <Compile Include="Domain\Entities\Traits.fs" />
    <Compile Include="Domain\Entities\Skills.fs" />
    <Compile Include="Domain\Entities\Feats.fs" />
    <Compile Include="Domain\Entities\Cantrips.fs" />
    <Compile Include="Domain\Entities\Spells.fs" />
    <Compile Include="Domain\Entities\Classes.fs" />
    <Compile Include="Domain\Entities\Subclasses.fs" />
    <Compile Include="Domain\Entities\ClassPassives.fs" />
    <Compile Include="Domain\Entities\SpecialPicks.fs" />
    <Compile Include="Domain\Entities\Equipment.fs" />
    <Compile Include="Domain\Entities\Weapons.fs" />
    <Compile Include="Domain\Character.fs" />
    <Compile Include="Domain\Helpers.fs" />
    <Compile Include="Domain\PickRules.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Update.fs" />        
    <Compile Include="ViewHelpers.fs" />
    <Compile Include="ViewPicker.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Main.fs" />
    <Compile Include="Startup.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="Bolero" Version="0.25.65" />
    <PackageReference Include="Bolero.Build" Version="0.25.65" />
    <PackageReference Include="FSharp.UMX" Version="1.1.0" />
    <PackageReference Include="System.Net.Http.Json" Version="11.0.*" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
    <PackageReference Include="Bolero.HotReload" Version="0.25.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" />
  </ItemGroup>
</Project>